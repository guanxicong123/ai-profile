# 默认模型配置（可在 /settings 页面覆盖并持久化到 SQLite）
# provider: anthropic | openai
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-5
# Anthropic
ANTHROPIC_API_KEY=
# OpenAI 兼容（豆包等）。豆包 baseURL 示例: https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 每次生成默认入选项目数
DEFAULT_PROJECT_COUNT=5

# SQLite 路径（相对项目根）
DB_PATH=data/app.db
